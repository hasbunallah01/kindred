# Kindred — Environment Variable Manifest
#
# Names and explanations only — no real values or secrets belong in this file.
# Copy this to .env (gitignored) and fill in real values locally; production
# values are set directly in Vercel / the VPS, never committed.
#
# Source of truth: KINDRED_IMPLEMENTATION_BLUEPRINT.md, Section 11.

# ---------------------------------------------------------------------------
# Database (Neon PostgreSQL, via Prisma)
# ---------------------------------------------------------------------------

# Obtained from: Neon project dashboard.
# Obtained when: the Neon project is created.
# For local development, point this at the docker-compose Postgres instead
# (see infra/docker-compose.dev.yml), e.g.:
#   postgresql://kindred:kindred@localhost:5432/kindred?schema=public
DATABASE_URL=

# ---------------------------------------------------------------------------
# Authentication (Better Auth)
# ---------------------------------------------------------------------------

# Obtained from: self-generated random value (e.g. `openssl rand -base64 32`).
# Obtained when: any time before first deploy.
BETTER_AUTH_SECRET=

# Obtained from: the app's deployed URL.
# Obtained when: once the domain/Vercel URL is known. Use a localhost URL
# (e.g. http://localhost:3000) during local development.
BETTER_AUTH_URL=

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------

# Obtained from: Resend dashboard.
# Obtained when: when the Resend account is created.
RESEND_API_KEY=

# Obtained from: a verified sender address/domain in Resend.
# Obtained when: after domain verification in Resend.
EMAIL_FROM=

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------

# Obtained from: BotFather.
# Obtained when: when the Kindred bot is created.
TELEGRAM_BOT_TOKEN=

# Obtained from: BotFather.
# Obtained when: same time as TELEGRAM_BOT_TOKEN.
TELEGRAM_BOT_USERNAME=

# Obtained from: self-generated (any random string).
# Obtained when: when registering the webhook with Telegram — sent by
# Telegram on every webhook request and validated before processing
# (see Blueprint Section 5.2).
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Redis (BullMQ broker)
# ---------------------------------------------------------------------------

# Obtained from: VPS-hosted Redis (or a managed provider).
# Obtained when: when Redis is provisioned.
# For local development, point this at the docker-compose Redis instead:
#   redis://localhost:6379
REDIS_URL=

# ---------------------------------------------------------------------------
# Minds (Animoca) — Hello Minds Builder API
# ---------------------------------------------------------------------------

# Obtained from: the official Hello Minds Builder API dashboard, after
# (1) creating a Minds account with at least one Mind, and (2) equipping
# "Hello Minds Messaging" onto it. Used as the X-Api-Key header on every
# request from packages/minds-client/index.ts. The earlier X-Access-Key
# header is deprecated and no longer accepted.
MINDS_BUILDER_API_KEY=

# Obtained from: the Hello Minds Builder dashboard — the specific Mind
# created for Kindred. An account can hold multiple Minds, so a
# conversation-creation request has to say which one. Passed as mindId
# in the CreateConversation request body
# (packages/minds-client/index.ts).
#
# The API base URL (https://api.build.hellominds.ai) is fixed and
# hardcoded in the client — it is not configurable via env.
MINDS_ID=

# ---------------------------------------------------------------------------
# OpenAI (conditional — subordinate preprocessing only, never the primary
# intelligence; see Blueprint Section 1.2 / 6.3)
# ---------------------------------------------------------------------------

# Obtained from: OpenAI dashboard.
# Obtained when: only if a preprocessing step proves necessary (optional —
# leave empty if unused; the ambiguous-message fallback defaults to off).
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Internal (apps/web <-> apps/agent coordination)
# ---------------------------------------------------------------------------

# Obtained from: self-generated.
# Obtained when: before any internal calls between the two apps are added.
VPS_INTERNAL_SHARED_SECRET=

# ---------------------------------------------------------------------------
# Demo / scheduling configuration
# ---------------------------------------------------------------------------

# Obtained from: self-defined, demo-only override.
# Obtained when: set before recording the demo video (see Blueprint Section 9
# / Build Plan Checkpoint 63). Compresses inactivity-threshold timing so the
# autonomous notification fires on a demo-friendly timescale. Leave unset in
# production.
DEMO_INACTIVITY_DAYS=

# Obtained from: self-defined.
# Obtained when: before scheduling any BullMQ jobs.
CRON_TIMEZONE=

# ---------------------------------------------------------------------------
# Standard / platform
# ---------------------------------------------------------------------------

# Obtained from: standard Node.js convention.
# Obtained when: always set (development | production | test).
NODE_ENV=development

# Obtained from: the deployed web app's public URL.
# Obtained when: once known. Use http://localhost:3000 during local development.
# Consumed by both apps/web (e.g. for OAuth redirects) and apps/agent
# (Checkpoint 53: the Telegram "View Dashboard" notification button is
# built as `${NEXT_PUBLIC_APP_URL}/dashboard`). Keeping a single URL
# env var means the dashboard button can never drift from the rest of
# the app's notion of its own URL.
NEXT_PUBLIC_APP_URL=
