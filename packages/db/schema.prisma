// Kindred — shared Prisma schema.
//
// Models are added incrementally per the Build Plan: Better Auth's four
// required models (Checkpoint 8), then Kindred's own domain models
// (Checkpoints 9-15), per Blueprint Section 3.
//
// Note: as of Prisma 7, the datasource block no longer holds the
// connection string — that lives in ./prisma.config.ts instead.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

// ---------------------------------------------------------------------------
// Better Auth — required core schema (Build Plan Checkpoint 8).
//
// Field names, types, and nullability match the official Better Auth core
// schema exactly: https://www.better-auth.com/docs/concepts/database
// Table names are mapped to Better Auth's lowercase defaults via @@map so
// the Prisma adapter finds them without extra configuration. No @default(...)
// is set on `id` fields — Better Auth's Prisma adapter generates and supplies
// IDs itself at write time (confirmed against Prisma's own official Better
// Auth + Prisma integration guide).
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime

  sessions Session[]
  accounts Account[]

  communities Community[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  token     String
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime
  updatedAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime
  updatedAt  DateTime

  @@map("verification")
}

// ---------------------------------------------------------------------------
// Kindred domain models (Build Plan Checkpoints 9-15, Blueprint Section 3.2).
// ---------------------------------------------------------------------------

enum CommunityStatus {
  pending_link
  active
  disconnected
}

model Community {
  id                   String          @id @default(uuid())
  creatorId            String
  telegramChatId       BigInt          @unique
  telegramChatTitle    String
  mindsConversationId  String?         @unique
  privacyModeConfirmed Boolean         @default(false)
  status               CommunityStatus @default(pending_link)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  creator User @relation(fields: [creatorId], references: [id])

  members Member[]
}

enum MemberStatus {
  active
  quiet
  inactive
  returned
}

model Member {
  id               String       @id @default(uuid())
  communityId      String
  telegramUserId   BigInt
  telegramUsername String?
  displayName      String
  firstSeenAt      DateTime
  lastSeenAt       DateTime
  status           MemberStatus @default(active)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  community Community @relation(fields: [communityId], references: [id])

  @@unique([communityId, telegramUserId])
  @@index([communityId, status])
}

