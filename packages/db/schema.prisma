// Kindred — shared Prisma schema.
//
// Models are added incrementally per the Build Plan: Better Auth's four
// required models (Checkpoint 8), then Kindred's own domain models
// (Checkpoints 9-15), per Blueprint Section 3.
//
// Note: as of Prisma 7, the datasource block no longer holds the
// connection string — that lives in ./prisma.config.ts instead.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

// ---------------------------------------------------------------------------
// Better Auth — required core schema (Build Plan Checkpoint 8).
//
// Field names, types, and nullability match the official Better Auth core
// schema exactly: https://www.better-auth.com/docs/concepts/database
// Table names are mapped to Better Auth's lowercase defaults via @@map so
// the Prisma adapter finds them without extra configuration. No @default(...)
// is set on `id` fields — Better Auth's Prisma adapter generates and supplies
// IDs itself at write time (confirmed against Prisma's own official Better
// Auth + Prisma integration guide).
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime

  sessions Session[]
  accounts Account[]

  communities Community[]

  notificationPreference NotificationPreference?
  telegramLinkRequests   TelegramLinkRequest[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  token     String
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime
  updatedAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime
  updatedAt  DateTime

  @@map("verification")
}

// ---------------------------------------------------------------------------
// Kindred domain models (Build Plan Checkpoints 9-15, Blueprint Section 3.2).
// ---------------------------------------------------------------------------

enum CommunityStatus {
  pending_link
  active
  disconnected
}

model Community {
  id                     String          @id @default(uuid())
  creatorId              String
  telegramChatId         BigInt          @unique
  telegramChatTitle      String
  mindsConversationId    String?         @unique
  privacyModeConfirmed   Boolean         @default(false)
  status                 CommunityStatus @default(pending_link)
  // Captured from the /link message's sender at linking time (Build Plan
  // Checkpoint 36) — the only way to know which Telegram identity is "the
  // creator" for detecting creator_interaction events. Nullable because
  // it can't be known before a valid /link message is ever processed.
  creatorTelegramUserId  BigInt?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  creator User @relation(fields: [creatorId], references: [id])

  members Member[]
  insights Insight[]
}

enum MemberStatus {
  active
  quiet
  inactive
  returned
}

model Member {
  id               String       @id @default(uuid())
  communityId      String
  telegramUserId   BigInt
  telegramUsername String?
  displayName      String
  firstSeenAt      DateTime
  lastSeenAt       DateTime
  status           MemberStatus @default(active)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  community Community @relation(fields: [communityId], references: [id])

  relationshipEvents RelationshipEvent[]
  insights           Insight[]

  @@unique([communityId, telegramUserId])
  @@index([communityId, status])
}

enum RelationshipEventType {
  joined
  first_interaction
  participation
  creator_interaction
  milestone
  absence_started
  returned
  contribution
  appreciation
}

model RelationshipEvent {
  id           String                @id @default(uuid())
  memberId     String
  type         RelationshipEventType
  payload      Json
  occurredAt   DateTime
  sentToMind   Boolean               @default(false)
  sentToMindAt DateTime?
  createdAt    DateTime              @default(now())

  member Member @relation(fields: [memberId], references: [id])

  @@index([memberId, occurredAt])
  // NOTE: the Blueprint calls for a *partial* index on (sentToMind = false)
  // so the digest-sender worker (Build Plan Checkpoint 43) can scan only
  // unbatched events cheaply. Prisma's schema DSL does not support WHERE-
  // clause partial indexes declaratively (confirmed: no @@index filter
  // syntax exists in Prisma 7). A plain index on sentToMind is the closest
  // schema-representable approximation for now; the true partial index
  // requires hand-editing the generated migration's raw SQL
  // (`prisma migrate dev --create-only`, then add
  // `CREATE INDEX ... ON "RelationshipEvent" (sentToMind) WHERE NOT sentToMind;`
  // before applying) — deferred to when Checkpoint 43 is implemented and
  // migrations can actually run against a reachable database/engine.
  @@index([sentToMind])
}

enum InsightSource {
  reactive
  autonomous
}

enum InsightStatus {
  unread
  read
  acted
}

model Insight {
  id          String        @id @default(uuid())
  communityId String
  memberId    String?
  source      InsightSource
  content     String
  status      InsightStatus @default(unread)
  createdAt   DateTime      @default(now())

  community Community @relation(fields: [communityId], references: [id])
  member    Member?   @relation(fields: [memberId], references: [id])

  notifications Notification[]

  @@index([communityId, createdAt])
}

enum NotificationChannel {
  dashboard
  telegram_dm
  email
}

enum NotificationStatus {
  pending
  sent
  failed
}

model Notification {
  id          String              @id @default(uuid())
  insightId   String
  channel     NotificationChannel
  status      NotificationStatus  @default(pending)
  deliveredAt DateTime?
  createdAt   DateTime            @default(now())

  insight Insight @relation(fields: [insightId], references: [id])

  @@index([insightId])
}

model NotificationPreference {
  id                    String    @id @default(uuid())
  creatorId             String    @unique
  telegramDmEnabled     Boolean   @default(true)
  emailEnabled          Boolean   @default(false)
  quietHoursStart       DateTime? @db.Time()
  quietHoursEnd         DateTime? @db.Time()
  maxDailyNotifications Int       @default(5)

  creator User @relation(fields: [creatorId], references: [id])
}

model TelegramLinkRequest {
  id          String    @id @default(uuid())
  creatorId   String
  code        String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?

  creator User @relation(fields: [creatorId], references: [id])
}

