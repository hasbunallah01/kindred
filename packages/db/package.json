{
  "name": "@kindred/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared Prisma schema and generated client for Kindred — used by both apps/web and apps/agent so both agree on one data model.",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^16.4.7",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "prisma": "^7.9.1",
    "typescript": "^5.7.0"
  }
}
